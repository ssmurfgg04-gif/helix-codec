{
  "name": "helix-codec",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Production DNA storage codec — Reed-Solomon, LDPC, convolutional, fountain, holographic sharding, content-addressed archives, and peer-leading deterministic encoding (BHE + Gungnir + DNA-Aeon)",
  "keywords": ["dna-storage", "reed-solomon", "ldpc", "convolutional-code", "fountain-code", "nanopore", "holographic-sharding", "wasm", "content-addressed", "helix"],
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "bench": "node scripts/quick-bench.js",
    "bench:full": "npx tsx scripts/bench-final.ts"
  },
